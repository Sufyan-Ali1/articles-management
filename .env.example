# Copy to .env. Supply unique secrets; there are no default passwords.
# Generate each secret independently: openssl rand -hex 32
ENVIRONMENT=development
POSTGRES_PASSWORD=
DB_APP_PASSWORD=
DB_MIGRATION_PASSWORD=
# Local Python execution uses the migrator for migrations, then the API role to serve.
# Replace the placeholder with the DB_APP_PASSWORD generated above.
DATABASE_URL=
JWT_SECRET=
JWT_ISSUER=blog-api
JWT_AUDIENCE=blog-clients
ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000","https://askandexplore.com"]
# Empty means forwarding headers are not trusted. Add only actual reverse proxy IPs.
TRUSTED_PROXY_IPS=[]
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=3000
REQUEST_TIMEOUT_SECONDS=30
MAX_BODY_BYTES=2097152
LIMITER_MAX_KEYS=10000
LOGIN_ACCOUNT_PER_MINUTE=5
LOGIN_IP_PER_MINUTE=30
MUTATIONS_PER_MINUTE=60
SUBMISSIONS_PER_TEN_MINUTES=5
SUBMISSIONS_PER_DAY=20
NEXTJS_REVALIDATION_ENABLED=false
NEXTJS_REVALIDATION_URL=
NEXTJS_REVALIDATION_SECRET=
# Optional: explicitly point tests at a disposable database ending in _test.
# TEST_DATABASE_URL=postgresql+asyncpg://blog_migrator:YOUR_URL_SAFE_PASSWORD@127.0.0.1:5432/blog_test

# Browser refresh sessions
REFRESH_SESSION_DAYS=7
REFRESH_COOKIE_SAMESITE=lax

# Cloudinary credentials stay on the backend. Images upload immediately (up to 2 MiB).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_MAX_IMAGE_BYTES=2097152
MEDIA_CLEANUP_GRACE_HOURS=24



# Apply migration 0005 before enabling scheduled publishing.
ARTICLE_SCHEDULER_ENABLED=true
ARTICLE_SCHEDULER_INTERVAL_SECONDS=30

# Server-to-server analytics key; use the same >=32-character value in the website.
# Never use a NEXT_PUBLIC_ prefix for this secret.
ANALYTICS_INGEST_SECRET=

# Public API consumer credentials, shared only with the website server.
API_USER=
API_KEY=
